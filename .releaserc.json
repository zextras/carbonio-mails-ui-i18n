{
  "branches": ["master"],
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits",
        "releaseRules": [
          { "breaking": true, "release": "major" },
          { "type": "feat", "release": "minor" },
          { "type": "fix", "release": "patch" },
          { "type": "refactor", "release": "patch" },
          { "type": "build", "release": "patch" },
          { "type": "ci", "release": false },
          { "type": "perf", "release": "patch" },
          { "type": "chore", "scope": "release", "release": false },
          { "header": "Added translation using Weblate*", "release": "minor" },
          { "header": "Translated using Weblate*", "release": "patch" },
          { "header": "Deleted translation using Weblate*", "release": "patch" },
          { "header": "Update translation files*", "release": "patch" },
          { "header": "*Weblate*", "release": "patch" }
        ]
      }
    ],
    "@semantic-release/github"
  ]
}
